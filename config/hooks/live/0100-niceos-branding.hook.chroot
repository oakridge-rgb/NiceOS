#!/bin/sh
# NiceOS system identity: os-release, issue, motd, hostname.
set -e

cat > /etc/os-release <<'EOF'
PRETTY_NAME="NiceOS 1.0"
NAME="NiceOS"
VERSION="1.0 (Trixie)"
VERSION_ID="1.0"
VERSION_CODENAME=trixie
ID=niceos
ID_LIKE=debian
HOME_URL="https://github.com/oakridge-rgb/NiceOS"
SUPPORT_URL="https://github.com/oakridge-rgb/NiceOS/issues"
BUG_REPORT_URL="https://github.com/oakridge-rgb/NiceOS/issues"
EOF
chmod 644 /etc/os-release

printf 'NiceOS 1.0 \\n \\l\n\n' > /etc/issue
printf 'NiceOS 1.0\n\n' > /etc/issue.net
printf 'NiceOS 1.0 — a purple-blue Debian 13 + XFCE desktop.\n' > /etc/motd
echo niceos > /etc/hostname
