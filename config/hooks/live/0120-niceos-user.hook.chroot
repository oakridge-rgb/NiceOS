#!/bin/sh
# Ensure the live user exists (belt & braces: live-build usually creates it,
# but hooks may run before lb_chroot_users on some live-build versions).
set -e

if ! getent passwd user >/dev/null 2>&1; then
    useradd -m -c "NiceOS live user" -s /bin/bash user
    echo 'user:live' | chpasswd
fi
